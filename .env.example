# ============================================================
# morning-brief 环境变量示例
# 复制为 .env（流水线侧）并填入你自己的值。所有 key 都是免费的。
# 本文件只是清单，不含任何真实密钥；真实 .env* 已被 gitignore。
# ============================================================

# ---------- AI 加工（智谱开放平台 https://open.bigmodel.cn 免费档）----------
# 每天给新闻起中文标题、写摘要、打兴趣分、做去重判断
LLM_API_KEY=
# OpenAI 兼容接口地址（默认智谱；可换 DeepSeek 等）
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# 主模型；免费档限流（429）时自动降级到下面的备用模型
LLM_MODEL=glm-4.7-flash
LLM_MODEL_FALLBACKS=glm-4-flash

# ---------- 数据库（Turso https://turso.tech 免费档，或本地文件）----------
# 本地开发用 file:./data/brief.db；线上用 libsql://<你的库>.turso.io
LIBSQL_URL=file:./data/brief.db
LIBSQL_AUTH_TOKEN=
# web 应用侧：把上面两个值写进 web/.env.local（本地）或 web/.env.cloud（Turso）

# ---------- 可选功能 ----------
# 网站访问密码（不设则公开访问；设置后未登录访问会跳转 /login）
# 线上配在 Netlify 环境变量里（运行时读取，无需重新构建）
APP_PASSWORD=
# 每周加密备份的口令（配在 GitHub Secrets；口令丢失 = 备份无法恢复）
BACKUP_PASSPHRASE=
# 备份输出文件（默认 web/data/backup-日期.enc）
# BACKUP_FILE=

# ---------- 部署（GitHub Actions 用，配在仓库 Secrets）----------
# NETLIFY_AUTH_TOKEN=   Netlify 个人访问令牌（部署网站）
# NETLIFY_SITE_ID=      已写死在 deploy-web.yml，换成你自己的站点 ID

# ---------- 流水线调优（一般不用动）----------
# POINTS_ENABLED=1            是否生成「原文精简版」
# PIPELINE_DEADLINE_MS=1500000   整条流水线的最长运行时间
# POINTS_MIN_SCORE=4          只对 ≥ 该分的资讯抓正文做精简版
